@using Questinator.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@functions {
    public async Task<ApplicationUser?> GetCurrentUserAsync()
    {
        if (User.Identity?.IsAuthenticated ?? false)
        {
            return await UserManager.GetUserAsync(User);
        }
        return null;
    }
}

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Questinator</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/info.css" />
    <link rel="stylesheet" href="~/css/quest.css" />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">

<header>
    <nav class="navbar navbar-expand-sm navbar-custom mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">Questinator</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Quests" ? "active" : "")" asp-area="" asp-page="/Quests">Quests</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Achievements" ? "active" : "")" asp-area="" asp-page="/Achievements">Achievements</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Store" ? "active" : "")" asp-area="" asp-page="/Store">Store</a>
                    </li>
                </ul>

                <!-- User section -->
                <div class="d-flex align-items-center gap-2">
                    @{
                        var currentUser = await GetCurrentUserAsync();
                    }

                    @if (currentUser != null)
                    {
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="navbar-initials">@currentUser.DisplayName?.Substring(0,1).ToUpper()</div>
                                <span>@currentUser.DisplayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Coins">
                                        Coins: <strong>@currentUser.Coins</strong>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Instellingen</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Profile">Profiel</a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                                        <button type="submit" class="dropdown-item btn btn-link">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <partial name="_LoginPartial" />
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container flex-grow-1">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted mt-auto">
    <div class="container">
        &copy; 2025 Questinator - <a asp-area="" asp-page="/Privacy">Privacy</a>
        <a href="https://youtu.be/xvFZjo5PgG0">Ik hoop je gerickrolled wordt!</a> -
        <a href="https://www.google.com/search?sca_esv=c863d9d6609f0e68&sxsrf=AE3TifMdESQTuiNJjT8ekM92jqGRjcXk6A:1766054001468&udm=2&fbs=AIIjpHw2KGh6wpocn18KLjPMw8n5ofjZQFej7XxDpLEwzn5636jPhZQ2SCHYNZOTHhCqX-lIANdm34OLsXpljMXvur-qOVxvA3NXiaKxlYQy-RRiasLGkzd4zqCUc8t8vI2F-h1nJA1utTYvqu2kpTmHUtQ7kaUGVvJcbPCfc9Trwsl4hdZsOuhb1DwK7z1ZfvqQTYc6nJeD&q=fijne+feestdagen+kaartje+met+een+middelvinger&sa=X&ved=2ahUKEwjGrqXr98aRAxX40wIHHU-ZAN0QtKgLegQIGhAB&biw=1920&bih=934&dpr=1#sv=CAMSVhoyKhBlLWNvSmczZno4aEt4ckRNMg5jb0pnM2Z6OGhLeHJETToOcDY4NTZrcjVLZ2JfdU0gBCocCgZtb3NhaWMSEGUtY29KZzNmejhoS3hyRE0YADABGAcg6tP3lwYwAkoKCAEQAhgCIAIoAg">Fijne feestdagen</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
