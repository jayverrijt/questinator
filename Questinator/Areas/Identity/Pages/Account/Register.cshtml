@page
@model RegisterModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Registreren - Questinator";
}

<body class="d-flex flex-column min-vh-100">

    <!-- Hero / Spotlight Header -->
    <header class="py-5 text-center hero-header-spotlight">
        <div class="container">
            <h1 class="display-4 fw-bold fade-in">Registreren bij Questinator</h1>
            <p class="lead fade-in" style="animation-delay:0.2s;">
                Maak een gratis account en ontdek alles wat Questinator te bieden heeft.
            </p>
        </div>
    </header>

    <!-- Register Form -->
    <section class="container my-5 flex-grow-1">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card p-4 fade-in" style="animation-delay:0.4s;">
                    <div class="card-body">
                        <form method="post">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <!-- Username -->
                            <div class="mb-3">
                                <label asp-for="Input.DisplayName" class="form-label"></label>
                                <input asp-for="Input.DisplayName" class="form-control"/>
                                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label"></label>
                                <input asp-for="Input.Email" class="form-control"/>
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label"></label>
                                <input asp-for="Input.Password" class="form-control"/>
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="mb-3">
                                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                                <input asp-for="Input.ConfirmPassword" class="form-control"/>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-success w-100">Registreren</button>
                        </form>

                        <p class="mt-3 text-center">
                            Heb je al een account? <a href="/Identity/Account/Login">Login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

</body>
